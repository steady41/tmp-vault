# Redis connection URL.
VAULT_REDIS_URL=redis://127.0.0.1:6379/0

# Optional defense-in-depth: a Fernet key (base64 32 bytes). If empty, the
# ciphertext blobs are stored in Redis as-is (still encrypted client-side).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_FERNET_KEY=

# TTL bounds (seconds) applied to the client-supplied ttl_seconds value.
VAULT_DEFAULT_TTL_SECONDS=86400
VAULT_MIN_TTL_SECONDS=60
VAULT_MAX_TTL_SECONDS=604800

# Rate limit: max secret creations per IP per minute.
VAULT_CREATE_RATE_LIMIT_PER_MINUTE=10

# Reject request bodies larger than this (bytes).
VAULT_MAX_REQUEST_BYTES=100000

# Set true when behind a reverse proxy so X-Forwarded-For is honored.
VAULT_TRUST_PROXY=true
